# ============ REQUIRED ============
MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/zapply?retryWrites=true&w=majority"

# At least 32 characters. In production the app now refuses to start without
# this rather than falling back to a key published in the repo, which would let
# anyone forge a session for any account. Generate one with:
#   openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-string"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shown on /contact. The page shipped with a placeholder that went nowhere.
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourdomain.com"

# ============ EXTENSION PACKAGING ============
# The API base baked into the packaged extension by `npm run ext:build`.
# Without it the build keeps background.js's default, and a published build
# would point every install at the user's own localhost. Falls back to
# NEXT_PUBLIC_APP_URL when unset.
ZAPPLY_API_BASE="https://your-app.vercel.app"

# ============ AI ============
# Primary AI provider: Google Gemini API. GOOGLE_API_KEY and GEMINI_API_KEY
# are both accepted; use one.
GOOGLE_API_KEY=""
GEMINI_API_KEY=""

# Optional text-answer fallback. Used only if Gemini text generation fails.
# It is NOT used for scanned PDF/image resume parsing.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# OPTIONAL. Leave this unset and the app queries the Gemini API at runtime and
# picks the best model your key can reach, falling back down a ladder
# (gemini-3.7-flash -> 3.6 -> 3.5 -> 2.5-flash -> flash-lite). That means a
# model retirement cannot break resume parsing.
# Set it only to pin a specific model. Do NOT pin a *-flash-lite model for
# resume parsing: it is the weakest tier and measurably worse at long resumes.
# GEMINI_MODEL="gemini-3.7-flash"

# OPTIONAL. Wall-clock budget for one resume parse, in milliseconds. Keep it
# below your platform's function timeout (Vercel Hobby = 60s, Pro = 300s).
# Also raise `maxDuration` in src/app/api/ai/parse-resume/route.ts to match.
# RESUME_PARSE_BUDGET_MS="48000"

# ============ BILLING ============
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PREMIUM_PRICE_ID=""

# ============ GOOGLE SIGN-IN ============
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============ EMAIL ============
RESEND_API_KEY=""
EMAIL_FROM="Zapply <onboarding@resend.dev>"
